# Hospardo – smistamento degli indirizzi (servizio "caddy" di docker-compose).
# HTTPS e certificati li gestisce Cloudflare: il tunnel porta qui le richieste in http.
#
#   https://DOMINIO        pagina web pubblica (cartella site)
#   https://www.DOMINIO    rimanda a https://DOMINIO
#   https://DOMINIO/prenota  richiesta di prenotazione dei pazienti (servita dall'agenda)
#   https://app.DOMINIO    agenda: area riservata del personale
#   http://localhost:4180  anteprima della pagina web da questo PC
#
# DOMINIO si imposta con HOSPARDO_DOMAIN nel file .env della cartella principale.
{
	auto_https off
	admin off
	servers {
		# il tunnel arriva dalla rete interna di Docker: conserva l'indirizzo originale del visitatore
		trusted_proxies static private_ranges
	}
}

(sicurezza) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(sito) {
	import sicurezza
	# pagine e dati pubblici dell'agenda sul dominio del sito: prenotazione, gestione appuntamento, informativa privacy
	# dal link nelle email, dati della pagina (contatti, prestazioni, medici). Nessuna pagina riservata.
	@agenda_pubblica path /prenota /prenota/* /appuntamento/* /privacy /assets/* /api/public/*
	handle @agenda_pubblica {
		reverse_proxy app:4100
	}
	handle {
		root * /srv/sito
		try_files {path} /index.html
		file_server
	}
}

http://app.{$HOSPARDO_DOMAIN} {
	import sicurezza
	# le pagine per i pazienti stanno sul dominio del sito
	@pazienti path /prenota /prenota/* /appuntamento/*
	redir @pazienti https://{$HOSPARDO_DOMAIN}{uri}
	reverse_proxy app:4100
}

http://www.{$HOSPARDO_DOMAIN} {
	redir https://{$HOSPARDO_DOMAIN}{uri} permanent
}

http://{$HOSPARDO_DOMAIN} {
	import sito
}

http://localhost {
	import sito
}

# qualsiasi altro indirizzo: non trovato
http:// {
	respond "Non trovato" 404
}
