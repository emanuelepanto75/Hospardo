# File .env della cartella principale (NON quello in backend): impostazioni di Docker.
# Copialo in .env e completa i valori:  copy .env.example .env

# Dominio di Hospardo (senza https:// e senza www), es. hospardo.it
HOSPARDO_DOMAIN=

# Tunnel Cloudflare dedicato (vedi docs/PUBBLICAZIONE.md)
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Porte sul PC (solo da questo PC): agenda e anteprima della pagina web
HOSPARDO_PORT=4100
HOSPARDO_SITE_PORT=4180

# Backup automatico notturno
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30
# BACKUP_DIR=C:/Users/nome/OneDrive/backup-hospardo
