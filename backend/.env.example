# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospardo?schema=public"

# Sicurezza
JWT_SECRET="cambia-questa-stringa-con-una-lunga-e-casuale"

# Server
PORT=4000
# Indirizzo pubblico dell'agenda (usato nei link delle email), es. https://app.hospardo.it
FRONTEND_URL="http://localhost:5173"
# Indirizzo del sito per i pazienti (prenotazione e link nelle email), es. https://hospardo.it
PUBLIC_URL=""
# Chi riceve l'avviso di nuova richiesta di prenotazione (default: REPORT_EMAIL, poi CLINIC_EMAIL)
REQUESTS_EMAIL=""
TIMEZONE="Europe/Rome"

# Dati dello studio (compaiono nelle email)
CLINIC_NAME="Studio Medico"
CLINIC_ADDRESS="Via Roma 1, Milano"
CLINIC_PHONE="02 1234567"
# Mostrati nella pagina web pubblica
CLINIC_EMAIL="info@example.com"
CLINIC_HOURS="Lunedì–Venerdì 9:00–19:00, Sabato 9:00–13:00"
CLINIC_DESCRIPTION="Visite specialistiche e odontoiatria su appuntamento. Prenota online in pochi secondi."
# false = non mostrare i prezzi né nella pagina web né nella prenotazione online
SITE_SHOW_PRICES=true
# false = non mostrare la durata delle prestazioni né nella pagina web né nella prenotazione online
SITE_SHOW_DURATIONS=true

# Email (se SMTP_HOST è vuoto le email vengono solo stampate nel log)
# Esempio Aruba: SMTP_HOST="smtps.aruba.it" SMTP_PORT=465 SMTP_USER="info@tuodominio.it" (indirizzo completo)
#               MAIL_FROM="Nome Studio <info@tuodominio.it>" (stesso indirizzo di SMTP_USER)
# Prova: docker compose exec app npm run email:test -- tuo@indirizzo.it
SMTP_HOST=""
SMTP_PORT=587
# vuoto = automatico (porta 465 -> SSL, altre -> STARTTLS)
SMTP_SECURE=
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Studio Medico <noreply@example.com>"

# Promemoria: "day_before" = il giorno prima della visita all'ora REMINDER_TIME
#             "hours"      = REMINDER_HOURS_BEFORE ore prima
REMINDER_MODE=day_before
REMINDER_TIME="10:00"
REMINDER_HOURS_BEFORE=24

# Riepilogo serale via email: Excel + calendario degli appuntamenti dei prossimi
# REPORT_DAYS giorni lavorativi (domenica esclusa). Più indirizzi separati da virgola.
REPORT_EMAIL=""
REPORT_TIME="22:00"
REPORT_DAYS=6

# WhatsApp automatico (vedi docs/whatsapp.md). Se WHATSAPP_PROVIDER è vuoto si usa
# l'invio "con un clic" dall'agenda (gratuito, dal numero WhatsApp dello studio).
WHATSAPP_PROVIDER=""          # "meta" (WhatsApp Cloud API) oppure "twilio"
WHATSAPP_DEFAULT_COUNTRY_CODE=39
WHATSAPP_TEMPLATE_LANG=it
# Nomi dei modelli approvati (Meta) oppure Content SID "HX..." (Twilio)
WHATSAPP_TEMPLATE_CONFERMA=""
WHATSAPP_TEMPLATE_PROMEMORIA=""
WHATSAPP_TEMPLATE_ANNULLAMENTO=""
WHATSAPP_TEMPLATE_SPOSTAMENTO=""
# Meta WhatsApp Cloud API
WHATSAPP_META_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # es. whatsapp:+14155238886
