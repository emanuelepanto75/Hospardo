# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospardo?schema=public"

# Sicurezza
JWT_SECRET="cambia-questa-stringa-con-una-lunga-e-casuale"

# Server
PORT=4000
# Indirizzo pubblico del frontend (usato nei link delle email)
FRONTEND_URL="http://localhost:5173"
TIMEZONE="Europe/Rome"

# Dati dello studio (compaiono nelle email)
CLINIC_NAME="Studio Medico"
CLINIC_ADDRESS="Via Roma 1, Milano"
CLINIC_PHONE="02 1234567"

# Email (se SMTP_HOST è vuoto le email vengono solo stampate nel log)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Studio Medico <noreply@example.com>"

# Promemoria: "day_before" = il giorno prima della visita all'ora REMINDER_TIME
#             "hours"      = REMINDER_HOURS_BEFORE ore prima
REMINDER_MODE=day_before
REMINDER_TIME="10:00"
REMINDER_HOURS_BEFORE=24

# Riepilogo serale via email: Excel + calendario degli appuntamenti dei prossimi
# REPORT_DAYS giorni lavorativi (domenica esclusa). Più indirizzi separati da virgola.
REPORT_EMAIL=""
REPORT_TIME="22:00"
REPORT_DAYS=6

# WhatsApp automatico (vedi docs/whatsapp.md). Se WHATSAPP_PROVIDER è vuoto si usa
# l'invio "con un clic" dall'agenda (gratuito, dal numero WhatsApp dello studio).
WHATSAPP_PROVIDER=""          # "meta" (WhatsApp Cloud API) oppure "twilio"
WHATSAPP_DEFAULT_COUNTRY_CODE=39
WHATSAPP_TEMPLATE_LANG=it
# Nomi dei modelli approvati (Meta) oppure Content SID "HX..." (Twilio)
WHATSAPP_TEMPLATE_CONFERMA=""
WHATSAPP_TEMPLATE_PROMEMORIA=""
WHATSAPP_TEMPLATE_ANNULLAMENTO=""
WHATSAPP_TEMPLATE_SPOSTAMENTO=""
# Meta WhatsApp Cloud API
WHATSAPP_META_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # es. whatsapp:+14155238886
