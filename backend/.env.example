# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospardo?schema=public"

# Sicurezza
JWT_SECRET="cambia-questa-stringa-con-una-lunga-e-casuale"

# Server
PORT=4000
# Indirizzo pubblico del frontend (usato nei link delle email)
FRONTEND_URL="http://localhost:5173"
TIMEZONE="Europe/Rome"

# Dati dello studio (compaiono nelle email)
CLINIC_NAME="Studio Medico"
CLINIC_ADDRESS="Via Roma 1, Milano"
CLINIC_PHONE="02 1234567"

# Email (se SMTP_HOST è vuoto le email vengono solo stampate nel log)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Studio Medico <noreply@example.com>"

# Ore di anticipo per il promemoria
REMINDER_HOURS_BEFORE=24
